{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConTextation",
  "version": "0.1.1",
  "identifier": "com.contextation.desktop",
  "build": {
    "beforeDevCommand": "node .\\node_modules\\vite\\bin\\vite.js",
    "beforeBuildCommand": "node .\\node_modules\\typescript\\bin\\tsc && node .\\node_modules\\vite\\bin\\vite.js build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ConTextation", "width": 1220, "height": 860, "minWidth": 900, "minHeight": 760 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
